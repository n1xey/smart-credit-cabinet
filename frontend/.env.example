# Адрес API.
#   /api/v1                — тот же хост через nginx (по умолчанию, docker compose)
#   http://localhost:4010  — Prism-мок по openapi.yaml (npm run mock)
#   mock                   — встроенный демо-мок без бэкенда (src/api/mock.ts); так запускает `npm run demo` (.env.demo)
VITE_API_URL=/api/v1
# Показывать демо-панель (быстрый вход под тестовыми учётками, сброс данных).
# TODO перед релизом: false — панель знает демо-пароль Demo12345! (данные синтетические, но в проде ей не место)
VITE_DEMO_MODE=true
