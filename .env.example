# Все переменные окружения проекта. Секреты в репозиторий не коммитим.
APP_ENV=dev
LOG_LEVEL=INFO
DEMO_MODE=true

# БД
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit
DATABASE_URL=postgresql+psycopg://credit:credit@db:5432/credit

# Auth
JWT_SECRET=change-me-in-env
JWT_TTL_MINUTES=60
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Таймеры процесса (в демо сокращены)
NEEDS_INFO_TTL_HOURS=72
OFFER_TTL_HOURS=72
SIGNING_TTL_HOURS=72
MAX_INFO_ROUNDS=2
JOB_LOCK_TIMEOUT_SEC=120

# Документы
UPLOADS_DIR=/data/uploads
DOC_MAX_SIZE_MB=10
DOC_ALLOWED_MIME=application/pdf,image/png,image/jpeg

# Моки внешних сервисов
BKI_URL=http://mock-bki:8001
EGRUL_URL=http://mock-egrul:8002
MOCK_BKI_FAIL_FIRST_N=0

# ИИ (по умолчанию выключен; без него продукт полностью работает)
AI_ENABLED=false
